{
  "name": "yanbot-harness",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0 <23"
  },
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "build:vm-guest": "node scripts/build-vm-runtime-root.mjs",
    "build": "pnpm -r --if-present build",
    "check": "pnpm format:check && pnpm lint && pnpm check:boundaries && pnpm build && pnpm typecheck && pnpm test:unit && pnpm test:probes",
    "check:boundaries": "node scripts/check-package-boundaries.mjs",
    "probe:distribution": "node scripts/test-distribution-packaging.mjs",
    "probe:managed-containment": "node scripts/probe-managed-containment.mjs",
    "probe:runtime-deploy": "pnpm build && node scripts/probe-runtime-deploy.mjs",
    "probe:runtime-archive": "pnpm build && node scripts/probe-runtime-deploy.mjs --archive",
    "test:probes": "node --test scripts/test-deploy-probe-audit.mjs scripts/test-normalize-runtime-staging.mjs scripts/test-runtime-archive-probe.mjs scripts/test-offline-kit.mjs",
    "build:client-packages": "node scripts/build-client-packages.mjs",
    "build:runtime-bundle": "node scripts/build-runtime-bundle.mjs",
    "build:platform-runtime": "node scripts/build-platform-runtime.mjs",
    "build:unified-common": "node scripts/build-unified-common.mjs",
    "build:offline-kit": "node scripts/build-offline-kit.mjs",
    "test:unified-installation": "node scripts/test-unified-installation.mjs",
    "test:unified-ci": "node scripts/run-unified-ci.mjs",
    "release:assemble": "node scripts/assemble-release.mjs",
    "release:build": "node scripts/build-release.mjs",
    "release:check": "node scripts/check-release-artifacts.mjs",
    "release:test": "node scripts/test-release-clean-room.mjs",
    "release:test:codebuddy": "node scripts/test-release-codebuddy.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "smoke:codebuddy": "pnpm build && node scripts/smoke-codebuddy.mjs",
    "test": "pnpm build && pnpm -r --if-present test:unit",
    "test:unit": "pnpm -r --if-present test:unit",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/node": "22.19.15",
    "eslint": "9.39.1",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.6.2",
    "tar-stream": "3.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.0",
    "vitest": "4.0.18"
  }
}
