{
  "name": "@yanbot-harness/cloud-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "provision": "node dist/bin/provision.js",
    "cleanup:workspaces": "node dist/bin/cleanup-workspaces.js",
    "sync:indexes": "node dist/bin/sync-indexes.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@nestjs/common": "11.1.27",
    "@nestjs/core": "11.1.27",
    "@nestjs/platform-express": "11.1.27",
    "@yanbot-harness/contracts": "workspace:*",
    "@yanbot-harness/cloud-queue": "workspace:*",
    "@yanbot-harness/workspace-snapshot": "workspace:*",
    "express": "5.2.1",
    "mongoose": "9.7.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@nestjs/testing": "11.1.27",
    "@yanbot-harness/sdk": "workspace:*",
    "@types/express": "5.0.6"
  }
}
