{
  "name": "@yanbot-harness/local-runtime",
  "version": "0.1.0-preview.2",
  "private": true,
  "type": "module",
  "description": "Portable local Runtime companion for Yanbot Harness SDK and CLI.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.22.0 <23"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "yanbot-harness-runtime": "dist/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "start:reference": "node dist/main.js --reference",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@yanbot-harness/adapter-api": "workspace:*",
    "@yanbot-harness/adapter-codebuddy": "workspace:*",
    "@yanbot-harness/adapter-reference": "workspace:*",
    "@yanbot-harness/config-loader": "workspace:*",
    "@yanbot-harness/contracts": "workspace:*",
    "@yanbot-harness/core": "workspace:*",
    "@yanbot-harness/extension-kit": "workspace:*",
    "@yanbot-harness/permission-engine": "workspace:*",
    "express": "5.2.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@yanbot-harness/testing": "workspace:*"
  }
}
